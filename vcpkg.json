{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "teserra",
  "version": "0.1.0",
  "description": "A modern C++20 game engine for indie developers",
  "homepage": "https://github.com/fyernald/teserra",
  "license": "MIT",
  "dependencies": [
    "glm",
    { "name": "msdfgen", "default-features": false },
    "spdlog",
    "tl-expected"
  ],
  "default-features": [
    "engine"
  ],
  "features": {
    "engine": {
      "description": "The window system, the shader compiler, image decoding and audio: everything but the portable modules (TESERRA_PORTABLE_ONLY=OFF)",
      "dependencies": [
        {
          "name": "glfw3",
          "features": [{ "name": "wayland", "platform": "linux" }]
        },
        "glslang",
        "miniaudio",
        "spirv-cross",
        "stb",
        "yyjson"
      ]
    },
    "tests": {
      "description": "Unit, integration and GPU tests (TESERRA_BUILD_TESTS)",
      "dependencies": [
        "catch2"
      ]
    },
    "shader-validation": {
      "description": "SPIR-V validation of teserra_shaderc's output in tests (TESERRA_SHADER_VALIDATION)",
      "dependencies": [
        "spirv-tools"
      ]
    },
    "profiling": {
      "description": "Tracy profiler client for TESERRA_ENABLE_PROFILING (ADR-0023); records only while a viewer is connected",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        }
      ]
    },
    "debug-ui": {
      "description": "Dear ImGui for the in-game debug tools (TESERRA_WITH_DEBUG_UI, ADR-0013)",
      "dependencies": [
        {
          "name": "imgui",
          "features": [
            "docking-experimental"
          ]
        }
      ]
    },
    "benchmarks": {
      "description": "Catch2 micro-benchmarks in benchmarks/ (TESERRA_BUILD_BENCHMARKS)",
      "dependencies": [
        "catch2"
      ]
    }
  }
}
