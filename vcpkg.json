{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "teserra",
  "version": "0.0.1",
  "description": "A modern C++20 game engine for indie developers",
  "homepage": "https://github.com/fyernald/teserra",
  "license": "MIT",
  "dependencies": [
    "glfw3",
    "glm",
    "glslang",
    "spdlog",
    "spirv-cross",
    "tl-expected"
  ],
  "features": {
    "tests": {
      "description": "Unit, integration and GPU tests (TESERRA_BUILD_TESTS)",
      "dependencies": [
        "catch2"
      ]
    },
    "shader-validation": {
      "description": "SPIR-V validation of teserra_shaderc's output in tests (TESERRA_SHADER_VALIDATION)",
      "dependencies": [
        "spirv-tools"
      ]
    }
  }
}
