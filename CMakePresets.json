{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/TeserraToolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "description": "Default local development build: MSVC, Ninja, Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "inherits": "windows-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-clang-debug",
      "displayName": "Windows clang-cl Debug",
      "description": "Second compiler: clang-cl, Ninja, Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows (MSVC)",
      "description": "GitHub Actions: MSVC Debug with warnings as errors and SPIR-V validation",
      "inherits": "windows-msvc-debug",
      "cacheVariables": {
        "TESERRA_WARNINGS_AS_ERRORS": "ON",
        "TESERRA_SHADER_VALIDATION": "ON"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "description": "Prepared for the Linux port: GCC 13+, Ninja, Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "description": "Prepared for the Linux port: Clang 17+, Ninja, Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-clang-debug", "configurePreset": "windows-clang-debug" },
    { "name": "ci-windows", "configurePreset": "ci-windows" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    { "name": "windows-msvc-debug", "inherits": "test-base", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "inherits": "test-base", "configurePreset": "windows-msvc-release" },
    { "name": "windows-clang-debug", "inherits": "test-base", "configurePreset": "windows-clang-debug" },
    {
      "name": "ci-windows",
      "inherits": "test-base",
      "configurePreset": "ci-windows",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      }
    },
    { "name": "linux-gcc-debug", "inherits": "test-base", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-clang-debug", "inherits": "test-base", "configurePreset": "linux-clang-debug" }
  ],
  "workflowPresets": [
    {
      "name": "windows-msvc-debug",
      "steps": [
        { "type": "configure", "name": "windows-msvc-debug" },
        { "type": "build", "name": "windows-msvc-debug" },
        { "type": "test", "name": "windows-msvc-debug" }
      ]
    },
    {
      "name": "windows-msvc-release",
      "steps": [
        { "type": "configure", "name": "windows-msvc-release" },
        { "type": "build", "name": "windows-msvc-release" },
        { "type": "test", "name": "windows-msvc-release" }
      ]
    },
    {
      "name": "windows-clang-debug",
      "steps": [
        { "type": "configure", "name": "windows-clang-debug" },
        { "type": "build", "name": "windows-clang-debug" },
        { "type": "test", "name": "windows-clang-debug" }
      ]
    },
    {
      "name": "ci-windows",
      "steps": [
        { "type": "configure", "name": "ci-windows" },
        { "type": "build", "name": "ci-windows" },
        { "type": "test", "name": "ci-windows" }
      ]
    },
    {
      "name": "linux-gcc-debug",
      "steps": [
        { "type": "configure", "name": "linux-gcc-debug" },
        { "type": "build", "name": "linux-gcc-debug" },
        { "type": "test", "name": "linux-gcc-debug" }
      ]
    },
    {
      "name": "linux-clang-debug",
      "steps": [
        { "type": "configure", "name": "linux-clang-debug" },
        { "type": "build", "name": "linux-clang-debug" },
        { "type": "test", "name": "linux-clang-debug" }
      ]
    }
  ]
}
