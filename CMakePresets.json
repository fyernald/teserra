{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/TeserraToolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "description": "Default local development build: MSVC, Ninja, Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "inherits": "windows-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-profile",
      "displayName": "Windows MSVC Profile",
      "description": "Optimized build with debug info and Tracy (TESERRA_ENABLE_PROFILING): connect Tracy 0.13.1 to see frames, phases, systems and passes",
      "inherits": "windows-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TESERRA_ENABLE_PROFILING": "ON"
      }
    },
    {
      "name": "windows-msvc-bench",
      "displayName": "Windows MSVC Benchmarks",
      "description": "Release with the micro-benchmarks (TESERRA_BUILD_BENCHMARKS), without tests or examples",
      "inherits": "windows-msvc-release",
      "cacheVariables": {
        "TESERRA_BUILD_BENCHMARKS": "ON",
        "TESERRA_BUILD_TESTS": "OFF",
        "TESERRA_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows MSVC AddressSanitizer",
      "description": "Debug with /fsanitize=address (TESERRA_ENABLE_SANITIZERS): memory errors stop the program with a report",
      "inherits": "windows-msvc-debug",
      "cacheVariables": {
        "TESERRA_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "windows-clang-debug",
      "displayName": "Windows clang-cl Debug",
      "description": "Second compiler: clang-cl, Ninja, Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows (MSVC)",
      "description": "GitHub Actions: MSVC Debug with warnings as errors and SPIR-V validation",
      "inherits": "windows-msvc-debug",
      "cacheVariables": {
        "TESERRA_WARNINGS_AS_ERRORS": "ON",
        "TESERRA_SHADER_VALIDATION": "ON"
      }
    },
    {
      "name": "ci-windows-release",
      "displayName": "CI Windows Release (MSVC)",
      "description": "GitHub Actions: MSVC Release with warnings as errors, for warnings that only Release builds show",
      "inherits": "windows-msvc-release",
      "cacheVariables": {
        "TESERRA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-windows-profile",
      "displayName": "CI Windows Profile (MSVC)",
      "description": "GitHub Actions: the profile build with warnings as errors, so the Tracy configuration keeps building",
      "inherits": "windows-msvc-profile",
      "cacheVariables": {
        "TESERRA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-windows-asan",
      "displayName": "CI Windows AddressSanitizer (MSVC)",
      "description": "GitHub Actions: the asan build with warnings as errors, for the sanitizer workflow",
      "inherits": "windows-msvc-asan",
      "cacheVariables": {
        "TESERRA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "description": "Linux with GCC 14.3+, Ninja, Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "description": "Linux with Clang 18+, Ninja, Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-linux-gcc",
      "displayName": "CI Linux (GCC)",
      "description": "GitHub Actions: GCC Debug with warnings as errors and SPIR-V validation",
      "inherits": "linux-gcc-debug",
      "cacheVariables": {
        "TESERRA_WARNINGS_AS_ERRORS": "ON",
        "TESERRA_SHADER_VALIDATION": "ON"
      }
    },
    {
      "name": "ci-linux-clang",
      "displayName": "CI Linux (Clang)",
      "description": "GitHub Actions: Clang Debug with warnings as errors and SPIR-V validation",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "TESERRA_WARNINGS_AS_ERRORS": "ON",
        "TESERRA_SHADER_VALIDATION": "ON"
      }
    },
    {
      "name": "linux-gcc-portable",
      "displayName": "Linux GCC portable",
      "description": "GitHub Actions: core, ecs, rhi + null backend with GCC, warnings as errors (TESERRA_PORTABLE_ONLY)",
      "inherits": "linux-gcc-debug",
      "cacheVariables": {
        "TESERRA_PORTABLE_ONLY": "ON",
        "TESERRA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-clang-portable",
      "displayName": "Linux Clang portable",
      "description": "GitHub Actions: core, ecs, rhi + null backend with Clang, warnings as errors (TESERRA_PORTABLE_ONLY)",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "TESERRA_PORTABLE_ONLY": "ON",
        "TESERRA_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-profile", "configurePreset": "windows-msvc-profile" },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan" },
    { "name": "windows-msvc-bench", "configurePreset": "windows-msvc-bench" },
    { "name": "windows-clang-debug", "configurePreset": "windows-clang-debug" },
    { "name": "ci-windows", "configurePreset": "ci-windows" },
    { "name": "ci-windows-release", "configurePreset": "ci-windows-release" },
    { "name": "ci-windows-profile", "configurePreset": "ci-windows-profile" },
    { "name": "ci-windows-asan", "configurePreset": "ci-windows-asan" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "ci-linux-gcc", "configurePreset": "ci-linux-gcc" },
    { "name": "ci-linux-clang", "configurePreset": "ci-linux-clang" },
    { "name": "linux-gcc-portable", "configurePreset": "linux-gcc-portable" },
    { "name": "linux-clang-portable", "configurePreset": "linux-clang-portable" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    { "name": "windows-msvc-debug", "inherits": "test-base", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "inherits": "test-base", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-profile", "inherits": "test-base", "configurePreset": "windows-msvc-profile" },
    { "name": "windows-msvc-asan", "inherits": "test-base", "configurePreset": "windows-msvc-asan" },
    { "name": "windows-clang-debug", "inherits": "test-base", "configurePreset": "windows-clang-debug" },
    {
      "name": "ci-windows",
      "inherits": "test-base",
      "configurePreset": "ci-windows",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      }
    },
    {
      "name": "ci-windows-release",
      "inherits": "test-base",
      "configurePreset": "ci-windows-release",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      }
    },
    {
      "name": "ci-windows-profile",
      "inherits": "test-base",
      "configurePreset": "ci-windows-profile",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      }
    },
    {
      "name": "ci-windows-asan",
      "inherits": "test-base",
      "configurePreset": "ci-windows-asan",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      }
    },
    { "name": "linux-gcc-debug", "inherits": "test-base", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-clang-debug", "inherits": "test-base", "configurePreset": "linux-clang-debug" },
    {
      "name": "ci-linux-gcc",
      "inherits": "test-base",
      "configurePreset": "ci-linux-gcc",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      }
    },
    {
      "name": "ci-linux-clang",
      "inherits": "test-base",
      "configurePreset": "ci-linux-clang",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      }
    },
    { "name": "linux-gcc-portable", "inherits": "test-base", "configurePreset": "linux-gcc-portable" },
    { "name": "linux-clang-portable", "inherits": "test-base", "configurePreset": "linux-clang-portable" }
  ],
  "workflowPresets": [
    {
      "name": "windows-msvc-debug",
      "steps": [
        { "type": "configure", "name": "windows-msvc-debug" },
        { "type": "build", "name": "windows-msvc-debug" },
        { "type": "test", "name": "windows-msvc-debug" }
      ]
    },
    {
      "name": "windows-msvc-release",
      "steps": [
        { "type": "configure", "name": "windows-msvc-release" },
        { "type": "build", "name": "windows-msvc-release" },
        { "type": "test", "name": "windows-msvc-release" }
      ]
    },
    {
      "name": "windows-clang-debug",
      "steps": [
        { "type": "configure", "name": "windows-clang-debug" },
        { "type": "build", "name": "windows-clang-debug" },
        { "type": "test", "name": "windows-clang-debug" }
      ]
    },
    {
      "name": "ci-windows",
      "steps": [
        { "type": "configure", "name": "ci-windows" },
        { "type": "build", "name": "ci-windows" },
        { "type": "test", "name": "ci-windows" }
      ]
    },
    {
      "name": "linux-gcc-debug",
      "steps": [
        { "type": "configure", "name": "linux-gcc-debug" },
        { "type": "build", "name": "linux-gcc-debug" },
        { "type": "test", "name": "linux-gcc-debug" }
      ]
    },
    {
      "name": "linux-clang-debug",
      "steps": [
        { "type": "configure", "name": "linux-clang-debug" },
        { "type": "build", "name": "linux-clang-debug" },
        { "type": "test", "name": "linux-clang-debug" }
      ]
    }
  ]
}
