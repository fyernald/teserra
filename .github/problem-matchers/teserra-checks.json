{
  "problemMatcher": [
    {
      "owner": "teserra-checks",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.+):(\\d+):(\\d+): error: (.+) \\[([a-z0-9-]+)\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "code": 5
        }
      ]
    }
  ]
}
