{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "minimal-game",
  "version": "0.1.0",
  "description": "A minimal game on Teserra",
  "dependencies": [
    {
      "name": "glfw3",
      "features": [{ "name": "wayland", "platform": "linux" }]
    },
    "glm",
    {
      "name": "imgui",
      "features": ["docking-experimental"]
    },
    "glslang",
    "spdlog",
    "spirv-cross",
    "stb",
    "tl-expected",
    "yyjson"
  ]
}
