# Shader compilation at build time (ADR-0017, docs/guides/build-and-ci.md#shaders-in-cmake).
#
#   teserra_add_shaders(<target>
#       SOURCES <file.vert|.frag|.comp>...
#       [EMBED [NAMESPACE <namespace>] [HEADER <path>]]
#       [OUTPUT_DIRECTORY <dir>]
#       [INCLUDE_DIRECTORIES <dir>...]
#       [DEFINES <name>[=<value>]...])
#
# Compiles each source with teserra_shaderc into a .tshader blob as part of building <target>. A source is
# recompiled when it, a file it includes (tracked through a depfile) or the tool changes; a shader error
# fails the build with the tool's file(line): error: message.
#
# Without EMBED the blobs are files for the game to load: <OUTPUT_DIRECTORY>/<source path>.tshader, where the
# source path is relative to the current source directory (default ${CMAKE_CURRENT_BINARY_DIR}/shaders).
#
# With EMBED the blobs are compiled into <target>. The generated header <HEADER> (default
# <target>/shaders.hpp), on the target's include path, declares one constant per shader in <NAMESPACE>
# (default `shaders`), named after the file: triangle.vert -> kTriangleVert, sprite_outline.frag ->
# kSpriteOutlineFrag:
#
#   extern const std::span<const std::byte> kTriangleVert;
#
# The data is 4-byte aligned, so SPIR-V can be passed on in place. Each embedded shader is its own
# translation unit: editing one recompiles only that one.
#
# INCLUDE_DIRECTORIES (relative to the current source directory) and DEFINES are passed to the tool as -I
# and -D. Call it in the directory that defines <target>. The tool is the executable target
# teserra_shaderc; teserra_rhi cannot use this function, because the tool links teserra_rhi.

include_guard(GLOBAL)

# Builds the constant name of a shader file: k + its file name in PascalCase.
function(_teserra_shader_symbol out file)
    get_filename_component(name "${file}" NAME)
    string(REGEX REPLACE "[^A-Za-z0-9]+" ";" words "${name}")
    set(symbol "k")
    foreach(word IN LISTS words)
        if(word STREQUAL "")
            continue()
        endif()
        string(SUBSTRING "${word}" 0 1 first)
        string(SUBSTRING "${word}" 1 -1 rest)
        string(TOUPPER "${first}" first)
        string(APPEND symbol "${first}${rest}")
    endforeach()
    set(${out} "${symbol}" PARENT_SCOPE)
endfunction()

function(teserra_add_shaders target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "EMBED" "NAMESPACE;HEADER;OUTPUT_DIRECTORY"
        "SOURCES;INCLUDE_DIRECTORIES;DEFINES")
    set(where "teserra_add_shaders(${target})")
    if(arg_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "${where}: unknown arguments: ${arg_UNPARSED_ARGUMENTS}")
    endif()
    if(NOT TARGET ${target})
        message(FATAL_ERROR "${where}: '${target}' is not a target")
    endif()
    get_target_property(target_dir ${target} SOURCE_DIR)
    if(NOT target_dir STREQUAL CMAKE_CURRENT_SOURCE_DIR)
        message(FATAL_ERROR "${where}: call it in the directory that defines the target (${target_dir})")
    endif()
    if(NOT TARGET teserra_shaderc)
        message(FATAL_ERROR "${where}: the shader compiler target teserra_shaderc does not exist")
    endif()
    if(NOT arg_SOURCES)
        message(FATAL_ERROR "${where}: SOURCES is required")
    endif()
    if(arg_EMBED AND DEFINED arg_OUTPUT_DIRECTORY)
        message(FATAL_ERROR "${where}: OUTPUT_DIRECTORY is for shader files, not EMBED")
    endif()
    if(NOT arg_EMBED AND (DEFINED arg_NAMESPACE OR DEFINED arg_HEADER))
        message(FATAL_ERROR "${where}: NAMESPACE and HEADER need EMBED")
    endif()

    set(tool_options "")
    foreach(directory IN LISTS arg_INCLUDE_DIRECTORIES)
        cmake_path(ABSOLUTE_PATH directory BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
        list(APPEND tool_options "-I${directory}")
    endforeach()
    foreach(define IN LISTS arg_DEFINES)
        list(APPEND tool_options "-D${define}")
    endforeach()

    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated/teserra_shaders/${target}")
    if(arg_EMBED)
        if(NOT DEFINED arg_NAMESPACE)
            set(arg_NAMESPACE "shaders")
        endif()
        if(NOT DEFINED arg_HEADER)
            set(arg_HEADER "${target}/shaders.hpp")
        endif()
        get_property(headers TARGET ${target} PROPERTY TESERRA_SHADER_HEADERS)
        if(arg_HEADER IN_LIST headers)
            message(FATAL_ERROR "${where}: the header ${arg_HEADER} was generated by an earlier call already")
        endif()
        set_property(TARGET ${target} APPEND PROPERTY TESERRA_SHADER_HEADERS "${arg_HEADER}")
        set(blob_dir "${generated}/blobs")
    elseif(DEFINED arg_OUTPUT_DIRECTORY)
        cmake_path(ABSOLUTE_PATH arg_OUTPUT_DIRECTORY BASE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}" NORMALIZE
            OUTPUT_VARIABLE blob_dir)
    else()
        set(blob_dir "${CMAKE_CURRENT_BINARY_DIR}/shaders")
    endif()

    set(embed_script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/scripts/EmbedShader.cmake")
    set(symbols "")
    set(declarations "")
    foreach(source IN LISTS arg_SOURCES)
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE
            OUTPUT_VARIABLE source_path)
        if(NOT EXISTS "${source_path}")
            message(FATAL_ERROR "${where}: ${source} does not exist")
        endif()
        if(NOT source_path MATCHES "\\.(vert|frag|comp)$")
            message(FATAL_ERROR "${where}: ${source} is not a .vert, .frag or .comp file")
        endif()
        # The path the blob keeps: relative to the source directory, or the file name for outside files.
        file(RELATIVE_PATH relative "${CMAKE_CURRENT_SOURCE_DIR}" "${source_path}")
        if(relative MATCHES "^\\.\\./")
            get_filename_component(relative "${source_path}" NAME)
        endif()

        set(blob "${blob_dir}/${relative}.tshader")
        add_custom_command(OUTPUT "${blob}"
            COMMAND teserra_shaderc "${source_path}" -o "${blob}" --depfile "${blob}.d" ${tool_options}
            DEPENDS "${source_path}" teserra_shaderc
            DEPFILE "${blob}.d"
            COMMENT "Compiling shader ${relative}"
            VERBATIM
        )

        if(NOT arg_EMBED)
            target_sources(${target} PRIVATE "${blob}")
            continue()
        endif()

        _teserra_shader_symbol(symbol "${relative}")
        if(symbol IN_LIST symbols)
            message(FATAL_ERROR "${where}: two shaders are both named ${symbol}; rename one of the files")
        endif()
        list(APPEND symbols "${symbol}")
        string(APPEND declarations "/// ${relative}\nextern const std::span<const std::byte> ${symbol};\n")

        set(cpp "${generated}/src/${relative}.cpp")
        add_custom_command(OUTPUT "${cpp}"
            COMMAND "${CMAKE_COMMAND}"
                "-DTESERRA_BLOB=${blob}"
                "-DTESERRA_OUTPUT=${cpp}"
                "-DTESERRA_SYMBOL=${symbol}"
                "-DTESERRA_NAMESPACE=${arg_NAMESPACE}"
                "-DTESERRA_HEADER=${arg_HEADER}"
                "-DTESERRA_SHADER=${relative}"
                -P "${embed_script}"
            DEPENDS "${blob}" "${embed_script}"
            COMMENT "Embedding shader ${relative}"
            VERBATIM
        )
        target_sources(${target} PRIVATE "${cpp}")
    endforeach()

    if(arg_EMBED)
        # Only declarations: written at configure time, so including it never waits for shader compiles.
        file(CONFIGURE OUTPUT "${generated}/include/${arg_HEADER}" @ONLY CONTENT [[
// Generated by teserra_add_shaders(): do not edit. The .tshader blobs of @target@ (ADR-0017).
#pragma once

#include <cstddef>
#include <span>

namespace @arg_NAMESPACE@ {

@declarations@
} // namespace @arg_NAMESPACE@
]])
        target_include_directories(${target} PRIVATE "${generated}/include")
    endif()
endfunction()
