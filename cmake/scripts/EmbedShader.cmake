# Writes the C++ source that embeds one .tshader blob, for teserra_add_shaders(... EMBED) in
# cmake/TeserraShaders.cmake. The file is only rewritten when its content changes, so a shader recompiled to
# the same blob does not recompile its C++.
#
#   cmake -DTESERRA_BLOB=<blob> -DTESERRA_OUTPUT=<cpp> -DTESERRA_SYMBOL=<kName> -DTESERRA_NAMESPACE=<ns>
#         -DTESERRA_HEADER=<header> -DTESERRA_SHADER=<shader path, for the comment> -P EmbedShader.cmake

file(READ "${TESERRA_BLOB}" hex HEX)
string(LENGTH "${hex}" digits)
if(digits EQUAL 0)
    message(FATAL_ERROR "EmbedShader: ${TESERRA_BLOB} is empty")
endif()
math(EXPR size "${digits} / 2")

# 16 bytes per line: "std::byte{0x54}, std::byte{0x53}, ..."
string(REGEX REPLACE "(................................)" "\\1\n" hex "${hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "std::byte{0x\\1}, " bytes "${hex}")
string(REGEX REPLACE ", \n" ",\n    " bytes "${bytes}")
string(REGEX REPLACE "[ \n]+$" "" bytes "${bytes}")

set(content "// Generated by teserra_add_shaders() from ${TESERRA_SHADER}: do not edit.

#include <${TESERRA_HEADER}>

#include <array>
#include <cstddef>
#include <span>

namespace ${TESERRA_NAMESPACE} {

namespace {

// 4-byte aligned, like the SPIR-V words inside.
alignas(4) constexpr std::array<std::byte, ${size}> kData{{
    ${bytes}
}};

} // namespace

const std::span<const std::byte> ${TESERRA_SYMBOL}{kData};

} // namespace ${TESERRA_NAMESPACE}
")

if(EXISTS "${TESERRA_OUTPUT}")
    file(READ "${TESERRA_OUTPUT}" existing)
    if(existing STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${TESERRA_OUTPUT}" "${content}")
